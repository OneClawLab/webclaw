{
  "type": "module",
  "name": "webclaw",
  "productName": "WebClaw",
  "version": "1.0.40",
  "description": "WebClaw - WebUI of TheClaw.",
  "main": "./out/main/index.js",
  "author": "TheClaw Authors",
  "homepage": "https://eidux.app/",
  "scripts": {
    "------basic-commands------": "------basic-commands------",
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json     --composite false && tsc --noEmit -p tsconfig.web.json     --composite false",
    "typecheck:dev": "tsc --noEmit -p tsconfig.node.dev.json --composite false && tsc --noEmit -p tsconfig.web.dev.json --composite false",
    "preview": "electron-vite preview",
    "------test-commands-----": "------test-commands-----",
    "test:cli": "cd test && npm test",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "------dev-commands------": "------dev-commands------",
    "pre-dev": "node scripts/predev.mjs",
    "dev": "npm run pre-dev && cross-env EIDUX_MODE=dev NODE_OPTIONS=--enable-source-maps electron-vite dev --inspect=5858 --remote-debugging-port=9222",
    "------common-build-commands------": "------common-build-commands------",
    "build": "cross-env EIDUX_MODE=dev     npm run typecheck:dev && electron-vite build",
    "build:release": "cross-env EIDUX_MODE=release npm run typecheck     && electron-vite build",
    "------------------------------": "------------------------------",
    "------packaging-commands------": "------packaging-commands------",
    "pack:win": "electron-builder --win   --config electron-builder.config.mjs --publish never",
    "pack:mac": "electron-builder --mac --config electron-builder.config.mjs --publish never",
    "pack:linux": "electron-builder --linux --config electron-builder.config.mjs --publish never",
    "------full-build-commands------": "------full-build-commands------",
    "release:win": "npm run build:release && npm run pack:win",
    "release:mac": "npm run build:release && npm run pack:mac",
    "release:linux": "npm run build:release && npm run pack:linux",
    "+++++++++++++++++++++++++++": "++++++++++++++++++++++++++++++++++++++++++",
    "------mac-full-builds------": "-----mac-special-full-build-commands------",
    "unpack:mac:x64": "npm run build:release && electron-builder --mac --x64 --dir --config electron-builder.config.mjs --publish never",
    "dev:mac:app:x64": "npm run unpack:mac:x64 && codesign --deep --force --sign - dist/mac/WebClaw.app",
    "unpack:mac:arm64": "npm run build:release && electron-builder --mac --arm64 --dir --config electron-builder.config.mjs --publish never",
    "dev:mac:app:arm64": "npm run unpack:mac:arm64 && codesign --deep --force --sign - dist/mac-arm64/WebClaw.app"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.1",
    "@codemirror/highlight": "^0.19.8",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/language": "^6.12.1",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.3",
    "@codemirror/view": "^6.39",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@floating-ui/react": "^0.27.16",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.6.2",
    "@radix-ui/colors": "^3.0.0",
    "@reduxjs/toolkit": "^2.11.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "bowser": "^2.13.1",
    "chalk": "^5.6.2",
    "clsx": "^2.1.1",
    "electron-updater": "^6.6.2",
    "hotkeys-js": "^4.0.0",
    "i18next": "^25.7.3",
    "js-beautify": "^1.15.4",
    "lucide-react": "^0.562.0",
    "nanoid": "^5.1.6",
    "radix-ui": "^1.4.3",
    "react-error-boundary": "^6.0.1",
    "react-hook-form": "^7.69.0",
    "react-redux": "^9.2.0",
    "safe-stable-stringify": "^2.5.0",
    "tailwind-merge": "^3.4.0",
    "winston": "^3.19.0",
    "ws": "^8.18.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.1.4",
    "autoprefixer": "^10.4.23",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "extract-zip": "^2.0.1",
    "fast-check": "^4.6.0",
    "ist": "^1.1.7",
    "playwright": "^1.59.1",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "rollup-plugin-visualizer": "^6.0.5",
    "sass": "^1.97.1",
    "sass-embedded": "^1.97.1",
    "tailwindcss": "^4.1.18",
    "tailwindcss-cli": "^0.1.2",
    "terser": "^5.44.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-javascript-obfuscator": "^3.1.0",
    "vitest": "^4.1.4"
  }
}
